{
  "name": "wii-voice-desktop",
  "version": "1.0.0",
  "description": "Peer-to-peer offline LAN voice calling & meetings",
  "author": "Wii Voice <support@wiivoice.local>",
  "homepage": "https://github.com/wii-voice/wii-voice-desktop",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:app": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:mac": "npm run build:app && electron-builder --mac",
    "build:win": "npm run build:app && electron-builder --win",
    "build:linux": "npm run build:app && electron-builder --linux",
    "build:all": "npm run build:app && electron-builder --mac --win --linux"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
